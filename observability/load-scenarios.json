{
  "version": 1,
  "description": "OPS-02 fixed load/soak/chaos scenarios. Numbers are committed here, never scattered through CI YAML. Thresholds are rule ids resolved from observability/slo.json (the OPS-01 ruleset); the server runs with SECURITY_MODE=enforce and only the documented limits are relaxed for synthetic loopback traffic.",
  "artifactsDir": "artifacts/gate",
  "defaults": {
    "serverEnv": {
      "BOTS": "0",
      "CLICK_COOLDOWN_MS": "0",
      "LIMIT_JOIN_MAX": "1000",
      "LIMIT_JOIN_WINDOW_MS": "60000",
      "LIMIT_JOIN_BURST": "1000",
      "LIMIT_ACTION_IP_MAX": "200000",
      "LIMIT_ACTION_IP_BURST": "200000",
      "MAX_SSE_PER_IP": "500",
      "MAX_SSE_GLOBAL": "5000"
    }
  },
  "scenarios": [
    {
      "id": "smoke",
      "generator": "load-test",
      "clients": 30,
      "sseClients": 15,
      "clicks": 5,
      "durationSeconds": 10,
      "clickPauseMs": 0,
      "repeat": 1,
      "timeoutSeconds": 120,
      "thresholds": {
        "httpP95Ms": "http-p95",
        "loopP95Ms": "loop-p95",
        "droppedSse": "sse-drop",
        "errors": "gate.errors",
        "joinP95Ms": "gate.joinP95Ms",
        "clickP95Ms": "gate.clickP95Ms",
        "responseBodyMiB": "gate.responseBodyMiB"
      }
    },
    {
      "id": "load",
      "generator": "load-test",
      "clients": 100,
      "sseClients": 40,
      "clicks": 5,
      "durationSeconds": 60,
      "clickPauseMs": 0,
      "repeat": 3,
      "timeoutSeconds": 600,
      "thresholds": {
        "httpP95Ms": "http-p95",
        "loopP95Ms": "loop-p95",
        "droppedSse": "sse-drop",
        "errors": "gate.errors",
        "joinP95Ms": "gate.joinP95Ms",
        "clickP95Ms": "gate.clickP95Ms",
        "responseBodyMiB": "gate.responseBodyMiB"
      }
    },
    {
      "id": "soak",
      "generator": "load-test",
      "clients": 40,
      "sseClients": 20,
      "clicks": 5,
      "durationSeconds": 7200,
      "clickPauseMs": 0,
      "repeat": 1,
      "timeoutSeconds": 7800,
      "thresholds": {
        "httpP95Ms": "http-p95",
        "loopP95Ms": "loop-p95",
        "droppedSse": "sse-drop",
        "errors": "gate.errors",
        "joinP95Ms": "gate.joinP95Ms",
        "clickP95Ms": "gate.clickP95Ms",
        "rssGrowthMiB": "gate.rssGrowthMiB",
        "responseBodyMiB": "gate.responseBodyMiB"
      }
    },
    {
      "id": "chaos",
      "generator": "chaos",
      "clients": 10,
      "sseClients": 5,
      "clicks": 0,
      "durationSeconds": 0,
      "clickPauseMs": 0,
      "repeat": 1,
      "timeoutSeconds": 180,
      "thresholds": {
        "reconnectMs": "gate.reconnectMs"
      }
    }
  ]
}
