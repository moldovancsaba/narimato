{
  "name": "narimato",
  "version": "3.57.0",
  "private": false,
  "type": "module",
  "description": "NARIMATO \u2014 the way back: persistent multiplayer mining, planet escape and deep-space progression on a spherical icosahedron",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "test": "node --test test/*.test.js",
    "docs:check": "node scripts/check-docs.mjs",
    "check:version": "node scripts/check-version.mjs",
    "check:slo": "node scripts/check-slo.mjs",
    "check:scale": "node scripts/check-scale-decision.mjs",
    "test:count": "node scripts/test-count.mjs --print",
    "backup:data": "node scripts/backup-data.mjs",
    "verify:data": "node scripts/verify-data.mjs",
    "restore:data": "node scripts/restore-data.mjs",
    "recovery:test": "node scripts/recovery-test.mjs",
    "audit:ui": "node scripts/audit-ui.mjs",
    "load:test": "node scripts/load-test.mjs",
    "audit:a11y": "node scripts/audit-a11y.mjs",
    "chaos:test": "node scripts/chaos-test.mjs",
    "voice:generate": "node scripts/generate-voice.mjs",
    "voice:verify": "node scripts/verify-voice.mjs",
    "copy:check": "node scripts/sync-story-copy.mjs --check",
    "copy:write": "node scripts/sync-story-copy.mjs --write",
    "build:ui": "node scripts/build-ui.mjs",
    "verify:ui": "node scripts/verify-gds-build.mjs",
    "gate:load": "node scripts/perf-gate.mjs",
    "perf:probe": "node scripts/perf-probe.mjs",
    "gate:perf": "node scripts/perf-probe.mjs --device=desktop --quality=0 --attempts=3 --check-baseline",
    "perf:baseline": "node scripts/perf-probe.mjs --device=desktop --quality=0 --attempts=3 --update-baseline",
    "verify:single-scene": "node scripts/verify-single-scene.mjs",
    "verify:hud": "node scripts/verify-hud-migration.mjs",
    "verify:overlays": "node scripts/verify-overlays.mjs",
    "verify:surface": "node scripts/verify-surface-hud.mjs",
    "verify:cine": "node scripts/verify-cine-chrome.mjs",
    "verify:zoom": "node scripts/verify-ui-zoom.mjs",
    "verify:migration": "node scripts/verify-ui-migration.mjs",
    "a11y:gate": "node scripts/a11y-gate.mjs",
    "a11y:gate:chromium": "node scripts/a11y-gate.mjs --engine=chromium",
    "a11y:gate:webkit": "node scripts/a11y-gate.mjs --engine=webkit"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "devDependencies": {
    "@sovereignsquad/gds": "6.9.0",
    "@sovereignsquad/gds-a11y": "6.9.0",
    "axe-core": "4.14.1",
    "playwright": "1.65.1",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "vite": "6.4.6"
  }
}
